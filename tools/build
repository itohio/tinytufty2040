#!/usr/bin/env python3
"""build — the Tufty firmware with its build ID baked in.

The ID is <tinytufty2040 commit>[+]/<tinygui commit>[+]@<MMDD-HHMM>: a + marks
a tree with uncommitted changes. The badge answers `version` with it and
`stats` starts with it.

    tools/build [out.uf2]      # default ../_scratch/tinygui/tufty.uf2
"""
import os, subprocess, sys, time

here = os.path.dirname(os.path.abspath(__file__))
repo = os.path.dirname(here)
out = sys.argv[1] if len(sys.argv) > 1 else os.path.join(repo, "..", "_scratch", "tinygui", "tufty.uf2")


def rev(path):
    h = subprocess.run(["git", "-C", path, "rev-parse", "--short=7", "HEAD"], capture_output=True, text=True).stdout.strip()
    dirty = subprocess.run(["git", "-C", path, "status", "--porcelain", "--untracked-files=no"],
                           capture_output=True, text=True).stdout.strip()
    return h + ("+" if dirty else "")


build_id = f"{rev(repo)}/{rev(os.path.join(repo, '..', 'tinygui'))}@{time.strftime('%m%d-%H%M')}"
env = dict(os.environ, GOTOOLCHAIN="local", GOPROXY="off")
cmd = ["tinygo", "build", "-target=tufty2040", "-size", "short",
       "-ldflags", f"-X main.buildID={build_id}", "-o", out, "."]
r = subprocess.run(cmd, cwd=repo, env=env)
if r.returncode != 0:
    sys.exit(r.returncode)
print("build", build_id)
print(os.path.abspath(out))
