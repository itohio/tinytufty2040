#!/usr/bin/env python3
"""build — the Tufty firmware with its build ID baked in.

The ID is <tinytufty2040 commit>[+]/<tinygui commit>[+]@<MMDD-HHMM>: a + marks
a tree with uncommitted changes. The badge answers `version` with it and
`stats` starts with it.

    tools/build [out.uf2]      # default build/tufty.uf2 (gitignored)
"""
import os, subprocess, sys, time

here = os.path.dirname(os.path.abspath(__file__))
repo = os.path.dirname(here)
out = sys.argv[1] if len(sys.argv) > 1 else os.path.join(repo, "build", "tufty.uf2")
os.makedirs(os.path.dirname(os.path.abspath(out)), exist_ok=True)


def rev(path):
    h = subprocess.run(["git", "-C", path, "rev-parse", "--short=7", "HEAD"], capture_output=True, text=True).stdout.strip()
    # untracked files count (review R-TG-postcommit G2: a new, un-added .go file
    # was compiled in while the ID looked clean); .gitignore'd files don't
    dirty = subprocess.run(["git", "-C", path, "status", "--porcelain", "--untracked-files=normal"],
                           capture_output=True, text=True).stdout.strip()
    return h + ("+" if dirty else "")


build_id = f"{rev(repo)}/{rev(os.path.join(repo, '..', 'tinygui'))}@{time.strftime('%m%d-%H%M')}"
env = dict(os.environ, GOTOOLCHAIN="local", GOPROXY="off")
# -stack-size: TinyGo can't size the three tasks' stacks (main, the serial
# writer, the console mux: recursive call graphs), so each takes the target's
# 8 KB from the heap; 6 KB each leaves the heap room for the Kalman filter
# (free 24 KB with both estimators; 8 KB stacks ran out of memory at boot)
cmd = ["tinygo", "build", "-target=tufty2040", "-stack-size=6KB", "-size", "short",
       "-ldflags", f"-X main.buildID={build_id}", "-o", out, "."]
r = subprocess.run(cmd, cwd=repo, env=env)
if r.returncode != 0:
    sys.exit(r.returncode)
print("build", build_id)
print(os.path.abspath(out))
